# Copy to .env (local dev) and add the same variable to your host's env settings.
# See README › Contact form and README › Media on Cloudflare R2.

# Optional. The contact form POSTs to the Forminit endpoint baked into Contact.jsx
# (https://forminit.com/f/6rarkqafu4u). Set this only to point a deployment at a
# DIFFERENT Forminit form.
VITE_FORMINIT_ENDPOINT=

# Optional. Media base URL — defaults to the R2 bucket (https://media.ibadportfolio.com).
# Set to a staging bucket or the raw pub-….r2.dev endpoint to override.
VITE_MEDIA_URL=
